# ─────────────────────────────────────────────────────────────────────
# НАШ аккаунт: База знаний, синхронизация документации
# ─────────────────────────────────────────────────────────────────────
# У каждого инженера свой ключ интеграции: только так в Базе знаний виден
# реальный автор правки (last_edited_by), а не общий бот-аккаунт.
PYRUS_LOGIN=your_bot_login@example.com
PYRUS_SECURITY_KEY=your_security_key_here

# Идентификатор сотрудника. ОБЯЗАТЕЛЕН, если ваша почта заведена в нескольких
# организациях Pyrus: без него сервис не понимает, в какую из них выдавать
# токен, и авторизация не проходит. У инженера внедрения это обычное дело.
PYRUS_PERSON_ID=

# ─────────────────────────────────────────────────────────────────────
# Аккаунты КЛИЕНТОВ: выгрузка состава форм и справочников
# ─────────────────────────────────────────────────────────────────────
# Один ключ на всех клиентов не работает — у каждого свой аккаунт Pyrus.
# Имя переменной строится по номеру кабинета: clients/02_Локанта_СубДилер_iiko
# читается как PYRUS_CLIENT_02_*.
#
# Три значения запрашиваются у клиента при начале работы с ним:
#   LOGIN         — логин интеграции (client id)
#   SECURITY_KEY  — ключ интеграции (client secret)
#   PERSON_ID     — идентификатор СОТРУДНИКА в его организации (person_id).
#                   Это НЕ organizationId из devtools: /auth такого параметра
#                   не знает и молча отвечает 500, как будто его не передали.
#
# PYRUS_CLIENT_02_LOGIN=
# PYRUS_CLIENT_02_SECURITY_KEY=
# PYRUS_CLIENT_02_PERSON_ID=

# Корни дерева документации в Базе знаний.
#
# PUBLIC   — кабинеты клиентов (clients/). Клиенту выдаётся доступ на ЕГО узел
#            (например «14.01 Демо кабинет»), соседние узлы он не видит.
#            Именно права на раздел, а не отдельное дерево, разграничивают доступ,
#            поэтому ТЗ и спецификации лежат в кабинете клиента: это описание
#            его собственных процессов и оплаченная им разработка.
# INTERNAL  — Банк решений и Техническая документация проекта: наработки по всем
#            клиентам сразу, не принадлежат никому из них.
#
# По решению владельца обе переменные указывают на один раздел: разграничение
# держится на правах, а внутренние ветки просто не выдаются клиентам.
# Если внутреннее понадобится вынести в отдельный раздел верхнего уровня —
# достаточно завести его в Базе знаний и поменять здесь один ID: синхронизатор
# покажет переносы как [MOVE?] и выполнит их по флагу --yes.
PYRUS_KB_ROOT_PUBLIC=IqKx9fi6OIH
PYRUS_KB_ROOT_INTERNAL=IqKx9fi6OIH

# Настройки среды (development / production)
NODE_ENV=development

# Включение расширенного логирования для симулятора
DEBUG_ENABLED=true
