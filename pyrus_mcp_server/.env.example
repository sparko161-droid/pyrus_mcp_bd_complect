# Pyrus MCP Server Environment Configuration

# Authentication (Pyrus API v4)
PYRUS_LOGIN=your_bot_email@domain.com
PYRUS_SECURITY_KEY=your_security_key_here
PYRUS_WEBHOOK_SECRET=your_webhook_secret_here

# Transport & Routing (If using SSE instead of stdio)
# MCP_TRANSPORT=sse
# PORT=8000
# HOST=0.0.0.0

# Logging & Monitoring
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# Threat Model & Limits
MAX_REQUESTS_PER_MINUTE=100
ENABLE_TENANT_ISOLATION=true
